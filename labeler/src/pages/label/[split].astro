---
import Layout from "../../layouts/Layout.astro";
import LabelView from "../../components/LabelView.astro";
import { isSplit, readLabels, readQueue, readQueueTracker } from "../../lib/store";

const { split } = Astro.params;
if (!isSplit(split)) return Astro.redirect("/");
const items = readQueue(split);
if (!items) return Astro.redirect("/");
// the blind second pass must not see earlier answers, only its own
const labels = Object.fromEntries(readLabels(split));
const payload = JSON.stringify({ split, items, labels });
---

<Layout title={`Labeln · ${split}`}>
  <script type="application/json" id="payload" set:html={payload} />
  <LabelView back="/" name={split} total={items.length} tracker={readQueueTracker(split)} />
</Layout>

<script>
  import { fullFrame, startLabeler, type Label, type Track } from "../../lib/labeler";

  type Item = { id: string; seq: string; t0: number; t1: number; top: number; scale: number; t: number[]; xy: [number, number][] };
  const { split, items, labels } = JSON.parse(document.getElementById("payload")!.textContent!) as {
    split: string; items: Item[]; labels: Record<string, Label>;
  };
  const tracks = items.map((it) => ({
    id: it.id, t0: it.t0, t1: it.t1, t: it.t,
    pts: it.xy.map(([x, y]) => [x / it.scale, (y + it.top) / it.scale] as [number, number]),
    seq: it.seq,
  }));

  async function call(method: string, body: object) {
    const res = await fetch(`/api/${split}/labels`, { method, headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
    if (!res.ok) throw new Error((await res.json()).error);
  }

  startLabeler({
    tracks,
    start: new URLSearchParams(location.search).get("track") ?? undefined,
    labels,
    media: (t: Track) => fullFrame(`/video/${(t as (typeof tracks)[number]).seq}`),
    backend: {
      save: (t, l) => call("POST", { id: t.id, ...l }),
      clear: (t) => call("DELETE", { id: t.id }),
    },
  });
</script>
