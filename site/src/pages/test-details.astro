---
// Detailed test tables: Test A and Test B against the three references (Mehrheit, Autor, einstimmig).
// Copies of outputs/eval/test_*/summary.json; the test was evaluated once, nothing is recomputed here.
import Layout from "../layouts/Layout.astro";
import { url } from "../lib/url";
import sameJson from "../data/test_summary_same_hive.json";
import otherJson from "../data/test_summary_other_hive.json";

const SPLITS: [string, string, any][] = [
  ["test_same_hive", "Test A · gleicher Stock", sameJson],
  ["test_other_hive", "Test B · anderer Stock", otherJson],
];
const REFS: [string, string, string][] = [
  ["Mehrheit (primär)", "Mehrheit (primär)", "Mehrheit der Stimmen von Florian, Labeler 2 und Labeler 3; bei Gleichstand entscheidet Florian."],
  ["Autor", "Autor", "nur die Labels von Florian."],
  ["einstimmig", "nur einstimmige Bahnen", "Bahnen mit mindestens 2 Stimmen, die alle gleich sind."],
];
const MODEL = "ensemble_kombi+B_yolo";
const CLS = ["orientierung", "sammelabflug", "anflug", "artefakt"];
const CN: Record<string, string> = { orientierung: "Orientierung", sammelabflug: "Sammelabflug", anflug: "Anflug", artefakt: "Artefakt" };
const SHORT: Record<string, string> = { orientierung: "Orient.", sammelabflug: "Sammel.", anflug: "Anflug", artefakt: "Artef." };

const de = (x: number | null | undefined, d = 3) => (x == null || Number.isNaN(x) ? "–" : x.toFixed(d).replace(".", ","));
const sg = (x: number, d = 3) => (x >= 0 ? "+" : "−") + Math.abs(x).toFixed(d).replace(".", ",");
// interval of a metric: 95 % cluster bootstrap (Test B) or span when leaving one sequence out (Test A)
const span = (m: any): { text: string; kind: string } => {
  if (m?.ci) return { text: `[${de(m.ci.low, 2)} – ${de(m.ci.high, 2)}]`, kind: "Bootstrap" };
  if (m?.loso) return { text: `[${de(m.loso.low, 2)} – ${de(m.loso.high, 2)}]`, kind: "LOSO" };
  return { text: "", kind: "" };
};
const wil = (a: number[] | null | undefined) => (a ? `[${de(a[0], 2)} – ${de(a[1], 2)}]` : "");
const diffSpan = (m: any) => (m?.ci ? `[${sg(m.ci.low, 2)} … ${sg(m.ci.high, 2)}]` : m?.loso ? `[${sg(m.loso.low, 2)} … ${sg(m.loso.high, 2)}]` : "");
---

<Layout title="Test-Details">
  <main>
    <a href={url("/")} class="back">← Start</a>
    <header>
      <div class="kicker">beeflight · Test</div>
      <h1>Test-Details</h1>
      <p>Das eingefrorene Modell (Ensemble Kombi + YOLO-Vorfilter) und die Regel als Vergleich, je auf Test A (gleicher Stock, 4 Sequenzen) und
        Test B (anderer Stock, 21 Sequenzen), gegen drei Referenzen. Der Test wurde einmal ausgewertet; diese Tabellen sind Kopien der Ergebnisdateien.
        Intervalle: Test B 95-%-Cluster-Bootstrap über Sequenzen; Test A nur die Spanne beim Weglassen je einer Sequenz (LOSO), weil 4 Sequenzen für einen Bootstrap zu wenige sind.</p>
    </header>

    {SPLITS.map(([key, title, data]) => (
      <section>
        <h2>{title}</h2>
        <div class="scroll">
          <table>
            <thead>
              <tr><th>Referenz</th><th>Bahnen</th><th>Orient.</th><th>Sammel.</th><th>Anflug</th><th>Artef.</th>
                <th>BA Modell</th><th>BA Regel</th><th>Δ BA Modell − Regel</th><th>F1 Orient. Modell</th></tr>
            </thead>
            <tbody>
              {REFS.map(([rk, rn]) => {
                const r = data[rk];
                const m = r.models[MODEL], u = r.models.rule;
                const cmp = r.comparison?.[MODEL]?.balanced_accuracy;
                const f1 = (2 * m.metrics.precision_orientierung.mean * m.metrics.recall_orientierung.mean) / (m.metrics.precision_orientierung.mean + m.metrics.recall_orientierung.mean);
                return (
                  <tr>
                    <td>{rn}</td><td>{r.n}</td>{CLS.map((c) => <td>{r.class_counts[c]}</td>)}
                    <td><b>{de(m.metrics.balanced_accuracy.mean)}</b> <small>{span(m.metrics.balanced_accuracy).text}</small></td>
                    <td>{de(u.metrics.balanced_accuracy.mean)} <small>{span(u.metrics.balanced_accuracy).text}</small></td>
                    <td>{cmp ? sg(cmp.difference) : "–"} <small>{diffSpan(cmp)}</small></td>
                    <td>{de(f1, 2)}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        <p class="sub">Klammern: {key === "test_same_hive" ? "Spanne beim Weglassen je einer der 4 Sequenzen (LOSO)" : "95-%-Intervall, Cluster-Bootstrap über 21 Sequenzen"}.
          Zufall wäre BA 0,25.</p>

        {REFS.map(([rk, rn, desc]) => {
          const r = data[rk];
          const m = r.models[MODEL];
          const m0 = m.metrics;
          return (
            <details class="ref">
              <summary><b>{rn}</b> · {r.n} Bahnen · BA {de(m0.balanced_accuracy.mean)}</summary>
              <p class="sub">Referenz: {desc}</p>
              <div class="cols">
                <div>
                  <h3>Je Klasse (Modell)</h3>
                  <table>
                    <thead><tr><th>Klasse</th><th>echte</th><th>vorhergesagt</th><th>richtig</th><th>Recall</th><th>Precision</th></tr></thead>
                    <tbody>
                      {m.classes.map((c: any) => (
                        <tr>
                          <td><i style={`background:var(--c-${c.class})`}></i>{CN[c.class]}</td><td>{c.n}</td><td>{c.predicted}</td><td>{c.correct}</td>
                          <td>{de(m0[`recall_${c.class}`]?.mean, 2)} <small>{wil(c.recall_wilson)}</small></td>
                          <td>{de(m0[`precision_${c.class}`]?.mean, 2)} <small>{wil(c.precision_wilson)}</small></td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                  <p class="sub">Klammern: Wilson-Intervalle (ignorieren die Abhängigkeit zwischen Bahnen einer Sequenz, eher zu eng).</p>
                </div>
                <div>
                  <h3>Konfusionsmatrix (Modell)</h3>
                  <table class="cm">
                    <thead><tr><th>wahr ↓ / erkannt →</th>{CLS.map((c) => <th>{SHORT[c]}</th>)}</tr></thead>
                    <tbody>
                      {m.confusion.map((row: number[], i: number) => (
                        <tr>
                          <th><i style={`background:var(--c-${CLS[i]})`}></i>{SHORT[CLS[i]]}</th>
                          {row.map((v, j) => <td class={i === j ? "diag" : ""} style={`--a:${Math.min(1, v / Math.max(1, row.reduce((a, b) => a + b, 0)))}`}>{v}</td>)}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                  <h3>Weitere Maße</h3>
                  <table>
                    <tbody>
                      <tr><td>Accuracy</td><td>{de(m0.accuracy.mean)} <small>{span(m0.accuracy).text}</small></td></tr>
                      <tr><td>Macro-F1</td><td>{de(m0.macro_f1.mean)} <small>{span(m0.macro_f1).text}</small></td></tr>
                      <tr><td>Anteilsfehler Orientierung</td><td>{sg(m0.share_error.mean)} <small>{span(m0.share_error).text}</small></td></tr>
                      <tr><td>AUROC Orientierung</td><td>{m.auroc_orientierung != null ? de(m.auroc_orientierung) : "–"}</td></tr>
                      {m.subgroups && Object.entries(m.subgroups).map(([g, v]: [string, any]) => (
                        <tr><td>BA {g} (n = {v.n})</td><td>{de(v.balanced_accuracy)}</td></tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            </details>
          );
        })}
      </section>
    ))}

    <section>
      <h2>Lesehilfe</h2>
      <ul class="sub">
        <li>Mehrheit ist die Hauptreferenz. „Autor“ nutzt nur Florians Labels, „einstimmig“ nur Bahnen, bei denen alle Labelnden gleich entschieden haben.</li>
        <li>Auf einstimmigen Bahnen ist das Modell deutlich besser: Viele Fehler liegen bei Bahnen, bei denen sich auch Menschen nicht einig sind.</li>
        <li>Test A hat nur 4 Sequenzen, die Intervalle dort sind knapp und zeigen nur die Abhängigkeit von einzelnen Sequenzen.</li>
        <li>Das Modell wurde auf Val ausgewählt und danach nicht mehr verändert. Die Regel ist der Vergleich ohne Lernen.</li>
      </ul>
    </section>
  </main>
</Layout>

<style>
  main { max-width: 1100px; margin: 0 auto; padding: 28px 16px 48px; }
  .back { text-decoration: none; color: var(--muted); font-size: 14px; }
  .kicker { font-size: 12px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-top: 16px; }
  h1 { font-size: 34px; margin: 4px 0 6px; letter-spacing: -.02em; }
  h2 { font-size: 22px; margin: 36px 0 8px; padding-top: 16px; border-top: 1px solid var(--line); }
  h3 { font-size: 14px; margin: 16px 0 6px; }
  header p, .sub { color: var(--muted); margin: 0 0 12px; max-width: 900px; font-size: 14px; }
  .scroll { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: 14px; background: #fff; border: 1px solid var(--line); }
  th, td { padding: 6px 8px; border-bottom: 1px solid var(--line); text-align: right; white-space: nowrap; }
  th:first-child, td:first-child { text-align: left; }
  th { font-weight: 600; color: var(--muted); font-size: 12px; background: var(--panel); }
  small { color: var(--muted); font-size: 11.5px; }
  i { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; }
  .ref { background: #fff; border: 1px solid var(--line); border-radius: 8px; margin: 10px 0; }
  .ref summary { cursor: pointer; padding: 10px 14px; }
  .ref[open] summary { border-bottom: 1px solid var(--line); }
  .ref > :not(summary) { margin-left: 14px; margin-right: 14px; }
  .ref > :last-child { margin-bottom: 14px; }
  .cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px; }
  .cm td { text-align: center; background: rgba(217, 154, 30, calc(var(--a) * .55)); }
  ul.sub { padding-left: 18px; }
  @media (max-width: 800px) { .cols { grid-template-columns: 1fr; } }
</style>
