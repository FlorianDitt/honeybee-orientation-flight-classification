---
import Layout from "../layouts/Layout.astro";
import { CLASSES, SPLITS, readCore, readLabels, readQueue, readQueueTracker, readSplits, readVoteFiles } from "../lib/store";
import { EVAL_TRACKERS, PER_TRACKER, readEval } from "../lib/evaluation";
import { readPose, readPoseQueue } from "../lib/pose";

const NAMES: Record<string, string> = {
  train: "Training",
  val: "Validierung",
  recheck: "Zweitlabeln (blind)",
  test_same_hive: "Test A · gleicher Stock",
  test_other_hive: "Test B · Stock B",
};
// goals from docs/roadmap.md (Phase 3)
const MIN_ORIENTATION = 40;

const rows = SPLITS.map((split) => {
  const queue = readQueue(split);
  const labels = readLabels(split);
  const counts = Object.fromEntries(CLASSES.map((c) => [c, 0]));
  for (const l of labels.values()) counts[l.label] += 1;
  const core = readCore(split);
  const coreDone = (queue ?? []).slice(0, core).filter((i) => labels.has(i.id)).length;
  return { split, name: NAMES[split], total: queue?.length ?? 0, done: labels.size, counts, ready: !!queue, core, coreDone };
});
const ready = rows.filter((r) => r.ready);
const missing = rows.filter((r) => !r.ready);
const tracker = readQueueTracker("train");
const votes = readVoteFiles();

// what to do next: the first split whose sample is not done yet; test only on purpose, after freezing the model
const isTest = (split: string) => split.startsWith("test");
const next = ready.find((r) => r.split !== "recheck" && !isTest(r.split) && r.coreDone < r.core);
const pct = (a: number, n: number) => (n ? Math.round((100 * a) / n) : 0);

// tools, with their state where it is cheap to read
const evalDone = readEval().size;
const evalTotal = EVAL_TRACKERS.length * PER_TRACKER;
const poseQueue = readPoseQueue();
const poseDone = poseQueue ? [...readPose().keys()].filter((id) => poseQueue.items.some((i) => i.id === id)).length : 0;
const tools = [
  { href: "/training", name: "Klassifikator trainieren", text: "Training starten und die Ergebnisse auf Validierung live verfolgen" },
  { href: "/compare", name: "Labels vergleichen", text: "Deine Labels und die Exporte der Helfenden nebeneinander, mit Mehrheitsergebnis" },
  { href: "/tracker", name: "Tracker vergleichen", text: "Dasselbe Video zweimal, links und rechts je ein Tracker" },
  { href: "/bewertung", name: "Tracker bewerten", text: "Blind: korrekt, Bruchstück, Bienenwechsel, keine Biene",
    status: `${evalDone} / ${evalTotal}` },
  { href: "/pose", name: "Kopf und Hinterleib", text: "Pilot Körperachse: Kopf und Hinterleib anklicken",
    status: poseQueue ? `${poseDone} / ${poseQueue.items.length}` : "keine Stichprobe" },
];

// data split as committed in src/beeflight/splits.py: time blocks, buffers in between, test used once
const SEQ_MIN = 30.03 / 60;
const PARTS = [
  { split: "train", name: "Training", role: "Labeln und Training" },
  { split: "val", name: "Validierung", role: "Schwellen, Hyperparameter, Modellauswahl" },
  { split: "test_same_hive", name: "Test A · gleicher Stock", role: "Wie gut ist die Methode? Nur einmal am Ende" },
  { split: "test_other_hive", name: "Test B · anderer Stock", role: "Wie gut überträgt sie sich? Nur einmal am Ende" },
];
const splitFile = readSplits();
const num = (seq: string) => Number(seq.slice(-3));
const range = (ids: string[]) => `${ids[0].slice(0, 7)} · Seq. ${ids[0].slice(-3)}–${ids.at(-1)!.slice(-3)}`;
const parts = splitFile ? PARTS.map((p) => {
  const ids = splitFile.splits[p.split] ?? [];
  const row = rows.find((r) => r.split === p.split);
  return { ...p, ids, range: ids.length ? range(ids) : "–", minutes: ids.length * SEQ_MIN, tracks: row?.ready ? row.total : null, done: row?.done ?? 0 };
}) : [];
// timeline of hive A (rec2123): one cell per sequence, colored by split
const timeline = splitFile ? [...PARTS.slice(0, 3).flatMap((p) => (splitFile.splits[p.split] ?? []).map((id) => ({ id, split: p.split }))),
  ...splitFile.buffers.filter((b) => b.startsWith("rec2123")).map((id) => ({ id, split: "buffer" }))].sort((a, b) => num(a.id) - num(b.id)) : [];
const hiveB = splitFile?.splits.test_other_hive ?? [];
const short = (t: string) => (t === "chiron2013-2d-chiron-linked" ? "Chiron + Huang" : t === "background-v3" ? "v3" : t);
---

<Layout title="Bienenflug-Labeler">
  <main>
    <header class="top">
      <div>
        <div class="kicker">beeflight · Handlabels</div>
        <h1>Flugbahnen labeln</h1>
        <p class="meta">
          {tracker && <span class="chip" title={tracker.info}>Tracking: <b>{short(tracker.id)}</b></span>}
          <span class="chip">Leitfaden: <code>docs/labeling.md</code></span>
        </p>
      </div>
      {next ? (
        <a class="cta" href={`/label/${next.split}`}>
          <small>Weiter labeln</small>
          <b>{next.name} →</b>
          <span>noch {next.core - next.coreDone} Bahnen in der Stichprobe</span>
        </a>
      ) : ready.length > 0 && (
        <div class="cta done"><small>Stichproben</small><b>alle gelabelt ✓</b><span>weiter mit den übrigen Bahnen oder Zweitlabeln</span></div>
      )}
    </header>

    {ready.length === 0 && (
      <section class="empty">
        <h2>Noch keine Warteschlange</h2>
        <p>Erst Flugbahnen erzeugen, dann eine Stichprobe ziehen:</p>
        <pre>uv run beeflight-sample --split train --n 300 --all --flights outputs/flights_chiron_linked
uv run beeflight-sample --split val --n 80 --all --flights outputs/flights_chiron_linked</pre>
      </section>
    )}

    <section class="progress">
      {ready.map((r) => {
        const labeled = CLASSES.reduce((a, c) => a + r.counts[c], 0);
        const sampleDone = r.coreDone >= r.core;
        return (
          <a class="card" href={`/label/${r.split}`}>
            <div class="card-head">
              <span class="name">{r.name}</span>
              {sampleDone ? <span class="badge ok">Stichprobe fertig</span> : <span class="badge">{pct(r.coreDone, r.core)} %</span>}
            </div>
            <div class="big">{r.coreDone}<span> / {r.core} Stichprobe</span></div>
            <div class="bar"><div style={`width:${pct(r.coreDone, r.core)}%`} /></div>
            {isTest(r.split) && <div class="rest"><b>Erst nach dem Einfrieren des Modells labeln</b></div>}
            <div class="rest">{r.total > r.core ? `${r.done} von allen ${r.total} Bahnen gelabelt` : `${r.done} gelabelt`}</div>

            {r.split !== "recheck" && labeled > 0 && (
              <>
                <div class="stack" title="Klassen der gelabelten Bahnen">
                  {CLASSES.map((c) => r.counts[c] > 0 && <i style={`flex:${r.counts[c]};background:var(--c-${c})`} />)}
                </div>
                <ul class="classes">
                  {CLASSES.map((c) => (
                    <li><i style={`background:var(--c-${c})`} />{c}<b>{r.counts[c]}</b></li>
                  ))}
                </ul>
              </>
            )}
            {r.split === "train" && (
              <div class={`goal ${r.counts.orientierung >= MIN_ORIENTATION ? "met" : ""}`}>
                Ziel ≥ {MIN_ORIENTATION} Orientierungsflüge: <b>{r.counts.orientierung}</b>
                {r.counts.orientierung < MIN_ORIENTATION && <> · noch {MIN_ORIENTATION - r.counts.orientierung}</>}
              </div>
            )}
          </a>
        );
      })}
    </section>

    {missing.length > 0 && ready.length > 0 && (
      <p class="later">Noch ohne Warteschlange: {missing.map((r) => r.name).join(" · ")}
        <span>(Tests erst nach dem Einfrieren des Modells)</span></p>
    )}

    <section>
      <h2>Werkzeuge</h2>
      <div class="tools">
        {tools.map((t) => (
          <a class="tool" href={t.href}>
            <b>{t.name}</b>
            <span>{t.text}</span>
            {t.status && <small>{t.status}</small>}
          </a>
        ))}
      </div>
    </section>

    <section>
      <div class="section-head">
        <div>
          <h2>Helfende</h2>
          <p>Exporte aus der Online-Version (<code>.jsonl</code>) hier hochladen, danach <code>uv run beeflight-vote</code>.
            Stimmen auf alten Bahnen werden dabei auf das aktuelle Tracking umgerechnet.</p>
        </div>
        <label class="upload">
          Exporte hochladen
          <input id="upload" type="file" accept=".jsonl,application/jsonl,text/plain" multiple hidden />
        </label>
      </div>
      <p id="upload-status" class="status" hidden></p>
      {votes.length === 0 ? (
        <p class="later">Noch keine Exporte.</p>
      ) : (
        <div class="people">
          {votes.map((v) => (
            <div class="person">
              <div class="who">
                <b>{v.annotator}</b>
                <code>{v.file}</code>
              </div>
              <div class="num"><b>{v.labels}</b><span>Labels</span></div>
              <div class="num"><b>{v.practice}</b><span>Übung</span></div>
              <div class="detail">
                {Object.entries(v.splits).map(([s, n]) => `${NAMES[s] ?? s} ${n}`).join(" · ")}
                <span>Bahnen: {short(v.tracker)}{tracker && v.tracker !== tracker.id && " (wird umgerechnet)"}
                  · {new Date(v.modified).toLocaleString("de-DE", { dateStyle: "short", timeStyle: "short" })}</span>
              </div>
              <button class="delete" type="button" data-file={v.file} title="Datei löschen">Löschen</button>
            </div>
          ))}
        </div>
      )}
    </section>

    {splitFile && (
      <section>
        <h2>Datensplit</h2>
        <p class="sub">Nach Zeitblöcken, nie nach Frames oder Bahnen. Puffersequenzen dazwischen werden verworfen, damit
          keine Bahn eine Grenze überquert. Definiert in <code>src/beeflight/splits.py</code>.</p>
        <div class="timeline">
          <div class="hive">
            <span>Stock A · rec2123</span>
            <div class="cells" style={`grid-template-columns:repeat(${timeline.length},1fr)`}>
              {timeline.map((c) => <i class={`s-${c.split}`} title={`${c.id} · ${c.split === "buffer" ? "Puffer (verworfen)" : c.split}`} />)}
            </div>
            <div class="ticks"><span>Seq. {timeline[0]?.id.slice(-3)}</span><span>Zeit →</span><span>Seq. {timeline.at(-1)?.id.slice(-3)}</span></div>
          </div>
          <div class="hive">
            <span>Stock B · rec2125</span>
            <div class="cells" style={`grid-template-columns:repeat(${hiveB.length},1fr)`}>
              {hiveB.map((id) => <i class="s-test_other_hive" title={`${id} · test_other_hive`} />)}
            </div>
          </div>
        </div>
        <div class="legend">
          <span><i class="s-train" />Training</span><span><i class="s-val" />Validierung</span>
          <span><i class="s-test_same_hive" />Test A</span><span><i class="s-test_other_hive" />Test B</span><span><i class="s-buffer" />Puffer</span>
        </div>
        <details>
          <summary>Details zu den Teilen</summary>
          <table>
            <thead><tr><th>Teil</th><th>Sequenzen</th><th>Dauer</th><th>Zweck</th><th>Bahnen · gelabelt</th></tr></thead>
            <tbody>
              {parts.map((p) => (
                <tr>
                  <td><i class={`dot s-${p.split}`} /><b>{p.name}</b></td>
                  <td>{p.range} <small>{p.ids.length} × 30 s</small></td>
                  <td>{p.minutes.toFixed(1)} min</td>
                  <td>{p.role}</td>
                  <td>{p.tracks === null ? <span class="muted">noch nicht getrackt</span> : <>{p.tracks} · {p.done}</>}</td>
                </tr>
              ))}
              <tr class="buffer">
                <td><i class="dot s-buffer" /><b>Puffer</b></td>
                <td>{splitFile.buffers.map((b) => `Seq. ${b.slice(-3)}`).join(", ")}</td>
                <td>{(splitFile.buffers.length * SEQ_MIN).toFixed(1)} min</td>
                <td>verworfen</td>
                <td></td>
              </tr>
            </tbody>
          </table>
        </details>
      </section>
    )}
  </main>
</Layout>

<script>
  const input = document.getElementById("upload") as HTMLInputElement;
  const status = document.getElementById("upload-status") as HTMLParagraphElement;
  const show = (text: string, error = false) => {
    status.hidden = false;
    status.textContent = text;
    status.classList.toggle("error", error);
  };
  input.addEventListener("change", async () => {
    const lines: string[] = [];
    let failed = false;
    for (const file of input.files ?? []) {
      const res = await fetch(`/api/votes?name=${encodeURIComponent(file.name)}`, { method: "POST", body: await file.text() });
      const r = await res.json();
      failed ||= !res.ok;
      lines.push(res.ok
        ? `${file.name}: ${r.annotator}, ${r.labels} Labels + ${r.practice} Übung${r.replaced ? " (ersetzt)" : ""}`
        : `${file.name}: ${r.error}`);
    }
    input.value = "";
    if (failed) show(lines.join("\n"), true);
    else location.reload();
  });
  document.querySelectorAll<HTMLButtonElement>("button.delete").forEach((btn) =>
    btn.addEventListener("click", async () => {
      const file = btn.dataset.file!;
      if (!confirm(`${file} wirklich löschen?`)) return;
      const res = await fetch(`/api/votes?name=${encodeURIComponent(file)}`, { method: "DELETE" });
      if (res.ok) location.reload();
      else show(`${file}: ${(await res.json()).error}`, true);
    }),
  );
</script>

<style>
  main { max-width: 1040px; margin: 0 auto; padding: 40px 20px 64px; }
  section { margin-top: 44px; }
  h2 { font-size: 13px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin: 0 0 14px; }
  code, pre { font-family: ui-monospace, "JetBrains Mono", monospace; font-size: 12.5px; }
  code { background: var(--panel); padding: 1px 6px; border-radius: 4px; }
  pre { background: var(--panel); padding: 14px 16px; border-radius: 8px; overflow-x: auto; }
  .muted { color: var(--muted); }

  /* header: title left, next step right */
  .top { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }
  .kicker { font-size: 12px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  h1 { font-size: 34px; margin: 4px 0 10px; letter-spacing: -.02em; line-height: 1.1; }
  .meta { display: flex; gap: 8px; flex-wrap: wrap; margin: 0; }
  .chip { font-size: 13px; color: var(--muted); border: 1px solid var(--line); background: #fff; border-radius: 999px; padding: 3px 12px; }
  .chip b { color: var(--ink); }
  .chip code { background: none; padding: 0; }
  .cta { display: flex; flex-direction: column; gap: 1px; text-decoration: none; background: var(--ink); color: #fff;
         border-radius: 12px; padding: 14px 22px; min-width: 260px; transition: transform .1s; }
  .cta:hover { transform: translateY(-1px); }
  .cta small { font-size: 12px; text-transform: uppercase; letter-spacing: .1em; opacity: .7; font-weight: 600; }
  .cta b { font-size: 22px; }
  .cta span { font-size: 13px; opacity: .75; }
  .cta.done { background: #e9f4ee; color: #1f6b43; }

  .empty { border: 2px dashed var(--line); border-radius: 10px; padding: 8px 20px 12px; }
  .empty h2 { text-transform: none; letter-spacing: 0; font-size: 18px; color: var(--ink); }

  /* progress cards */
  .progress { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; margin-top: 32px; }
  .card { display: block; text-decoration: none; color: inherit; background: #fff; border: 1px solid var(--line);
          border-radius: 14px; padding: 20px 22px; transition: border-color .15s, box-shadow .15s; }
  .card:hover { border-color: var(--accent); box-shadow: 0 4px 18px rgba(0,0,0,.05); }
  .card-head { display: flex; justify-content: space-between; align-items: center; }
  .name { font-weight: 700; font-size: 16px; }
  .badge { font-size: 12px; font-weight: 600; background: var(--panel); border-radius: 999px; padding: 2px 10px; color: var(--muted); }
  .badge.ok { background: #e9f4ee; color: #1f6b43; }
  .big { font-size: 40px; font-weight: 700; letter-spacing: -.02em; margin: 10px 0 8px; line-height: 1; }
  .big span { font-size: 15px; color: var(--muted); font-weight: 500; letter-spacing: 0; }
  .bar { height: 8px; background: var(--panel); border-radius: 4px; overflow: hidden; }
  .bar div { height: 100%; background: var(--accent); border-radius: 4px; }
  .rest { font-size: 13px; color: var(--muted); margin-top: 8px; }
  .stack { display: flex; height: 10px; border-radius: 5px; overflow: hidden; gap: 2px; margin-top: 18px; }
  .classes { list-style: none; padding: 0; margin: 10px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 4px 20px; font-size: 13px; color: var(--muted); }
  .classes li { display: flex; align-items: center; gap: 7px; }
  .classes li b { margin-left: auto; color: var(--ink); }
  .classes li i { width: 9px; height: 9px; border-radius: 2px; display: inline-block; }
  .goal { margin-top: 14px; font-size: 13px; border-radius: 8px; padding: 7px 12px; background: #fff4e5; color: #8a5a00; }
  .goal.met { background: #e9f4ee; color: #1f6b43; }
  .later { color: var(--muted); font-size: 13px; margin-top: 14px; }
  .later span { opacity: .8; }

  /* tools */
  .tools { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
  .tool { display: flex; flex-direction: column; gap: 4px; text-decoration: none; color: inherit; background: var(--panel);
          border: 1px solid transparent; border-radius: 12px; padding: 14px 16px; transition: border-color .15s; }
  .tool:hover { border-color: var(--accent); }
  .tool b { font-size: 15px; }
  .tool span { font-size: 13px; color: var(--muted); line-height: 1.4; }
  .tool small { margin-top: auto; padding-top: 6px; font-size: 12px; font-weight: 600; color: var(--ink); }

  /* helpers */
  .section-head { display: flex; gap: 16px; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; }
  .section-head p { color: var(--muted); font-size: 14px; margin: -6px 0 0; max-width: 70ch; }
  .upload { background: var(--accent); color: #fff; font-weight: 600; padding: 9px 16px; border-radius: 8px; cursor: pointer; white-space: nowrap; }
  .upload:hover { filter: brightness(.95); }
  .status { white-space: pre-line; font-size: 13px; background: var(--panel); padding: 10px 14px; border-radius: 8px; }
  .status.error { color: #b42318; }
  .people { display: flex; flex-direction: column; gap: 8px; margin-top: 14px; }
  .person { display: grid; grid-template-columns: minmax(180px, 1.2fr) 70px 70px 2fr auto; gap: 16px; align-items: center;
            background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 12px 16px; }
  .who { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .who b { font-size: 15px; }
  .who code { font-size: 11.5px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; background: none; padding: 0; }
  .num { display: flex; flex-direction: column; }
  .num b { font-size: 20px; line-height: 1.1; }
  .num span { font-size: 12px; color: var(--muted); }
  .detail { font-size: 13px; }
  .detail span { display: block; font-size: 12px; color: var(--muted); margin-top: 2px; }
  .delete { background: none; border: 1.5px solid #e4a8a2; color: #b42318; font: inherit; font-size: 13px; font-weight: 600;
            padding: 4px 10px; border-radius: 6px; cursor: pointer; }
  .delete:hover { background: #fef3f2; }

  /* data split */
  .sub { color: var(--muted); font-size: 14px; margin: -6px 0 16px; }
  .timeline { display: grid; grid-template-columns: 75fr 21fr; gap: 16px; }
  .hive > span { font-size: 12px; color: var(--muted); font-weight: 600; }
  .cells { display: grid; gap: 1px; height: 22px; margin-top: 4px; }
  .cells i { border-radius: 2px; }
  .ticks { display: flex; justify-content: space-between; font-size: 11px; color: var(--muted); margin-top: 3px; }
  .s-train { background: #d99a1e; }
  .s-val { background: #3d93c9; }
  .s-test_same_hive { background: #16181d; }
  .s-test_other_hive { background: #6b7280; }
  .s-buffer { background: repeating-linear-gradient(45deg, #e5e7eb 0 3px, #fff 3px 6px); outline: 1px solid #e5e7eb; outline-offset: -1px; }
  .legend { display: flex; flex-wrap: wrap; gap: 14px; font-size: 13px; color: var(--muted); margin: 12px 0 4px; }
  .legend span { display: flex; align-items: center; gap: 6px; }
  .legend i, .dot { width: 10px; height: 10px; border-radius: 2px; display: inline-block; }
  .dot { margin-right: 8px; }
  details { margin-top: 12px; }
  summary { cursor: pointer; font-size: 14px; color: var(--muted); }
  table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 14px; }
  th { text-align: left; font-size: 12px; color: var(--muted); font-weight: 600; padding: 6px 8px; border-bottom: 1px solid var(--line); }
  td { padding: 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
  td small { display: block; font-size: 12px; color: var(--muted); }
  tr.buffer td { color: var(--muted); }

  @media (max-width: 720px) {
    .timeline { grid-template-columns: 1fr; }
    table { display: block; overflow-x: auto; }
    .person { grid-template-columns: 1fr auto auto; }
    .person .detail { grid-column: 1 / -1; }
  }
</style>
